#include<iostream>
using namespace std;
int main()
{
 int bookid[5];
 int sortid;
 cout<<"Enter 5 Book IDs:\n";
 for(int i=0;i<5;i++)
{
 cout<<"Book"<<i+1<<":";
 cin>>bookid[i];
}
 for(int i=0;i<5;i++)
{
 for(int j=0;j<5;j++)
{
 if(bookid[j]>bookid[j+1])
{
 int temp=bookid[j];
 bookid[j]=bookid[j+1];
 bookid[j+1]=temp;
}
}
}
cout<<"\nBook IDs in ascending order:\n";
for(int i=0;i<5;i++)
{
cout<< bookid[i] <<" ";
}
cout<<endl;
return 0;
}

